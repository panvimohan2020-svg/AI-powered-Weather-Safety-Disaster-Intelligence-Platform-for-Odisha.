# ==============================================================================
# Odisha WRI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values if using custom services.
# Note: The platform operates with Open-Meteo, NASA POWER, ERA5, and USGS/NCS
# APIs by default without requiring proprietary commercial API keys.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Web Push Notification Service (Optional - Auto-generated if omitted)
# Generate your own VAPID keys using 'web-push generate-vapid-keys'
VAPID_PUBLIC_KEY=your_base64_url_vapid_public_key_here
VAPID_PRIVATE_KEY=your_base64_url_vapid_private_key_here
VAPID_CLAIM_EMAIL=mailto:emergency-alert@odisha-wri.gov.in

# Twilio WhatsApp Webhook Configuration (Optional for SMS/WhatsApp Alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# IoT Hyperlocal Station Telemetry Auth (Optional)
IOT_STATION_SECRET_KEY=your_iot_station_ingestion_token_here

